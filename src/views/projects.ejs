<%- include('partials/header') %>
    <main>
        <h1>Service Projects</h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% upcomingProjects.forEach(project => { %>
                <li>
                    <%= project.date.toLocaleDateString() %>: <%= project.title %>
                    <a href="/organization/<%= project.organization_id %>">(<%= project.name %>)</a>
                </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>