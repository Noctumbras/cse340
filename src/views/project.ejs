<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>

    <section>
        <p><strong>Description:</strong> <%= project.description %></p>
        <p><strong>Date:</strong> <%= project.date.toLocaleDateString() %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p><strong>Partner Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.name %></a></p>
        <p><strong>Categories:</strong> 
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.category_id %>"><%= category.name %></a>
            <% }) %> 
        </p>
    </section>

    <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
    <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
</main>
<%- include('partials/footer') %>